def validate_url(url):
    try:
        parsed = urlparse(url)

        if parsed.scheme not in ("http", "https") or not parsed.hostname:
            return False, "सही HTTP/HTTPS लिंक दें।"

        if parsed.username or parsed.password:
            return False, "लिंक में login विवरण स्वीकार नहीं हैं।"

        host = parsed.hostname.lower()

        if host == "localhost" or host.endswith(".localhost"):
            return False, "लोकल वेबसाइट की अनुमति नहीं है।"

        if parsed.port not in (None, 80, 443):
            return False, "केवल सामान्य HTTP/HTTPS पोर्ट स्वीकार हैं।"

        addresses = socket.getaddrinfo(host, None)

        if not addresses:
            return False, "वेबसाइट का पता नहीं मिला।"

        for addr in addresses:
            ip = ipaddress.ip_address(addr[4][0].split("%")[0])
            if not ip.is_global:
                return False, "निजी नेटवर्क की अनुमति नहीं है।"

        return True, ""

    except Exception:
        return False, "वेबसाइट का पता जाँचा नहीं जा सका।"

