@app.post("/ask")
def ask():
    data = request.get_json(silent=True) or {}
    task = str(data.get("task", "")).strip()

    if not task:
        return jsonify(error="कृपया अपना काम लिखें।"), 400
    if len(task) > 4000:
        return jsonify(error="काम का विवरण बहुत लंबा है।"), 400
    if not client:
        return jsonify(
            error="Meta API चालू नहीं है। MODEL_API_KEY सेट करें।"
        ), 503

    try:
        response = client.chat.completions.create(
            model=META_MODEL,
            messages=[
                {
                    "role": "system",
                    "content": (
                        "आप हिंदी में मदद करने वाले वेबसाइट सहायक हैं। "
                        "स्पष्ट करें कि आप क्या कर सकते हैं और कौन-सी "
                        "जानकारी चाहिए।"
                    )
                },
                {"role": "user", "content": task}
            ]
        )
        answer = response.choices[0].message.content
        return jsonify(answer=answer or "AI से कोई जवाब नहीं मिला।")
    except Exception:
        app.logger.exception("Meta API error")
        return jsonify(error="Meta AI से संपर्क नहीं हो पाया।"), 502


@app.post("/inspect")
def inspect():
    data = request.get_json(silent=True) or {}
    url = str(data.get("url", "")).strip()
    valid, error = validate_url(url)

    if not valid:
        return jsonify(error=error), 400

    try:
        from playwright.sync_api import sync_playwright
        with sync_playwright() as p:
            browser = p.chromium.launch(headless=True)
            page = browser.new_page()
            page.goto(url, wait_until="domcontentloaded", timeout=20000)

            fields = page.locator(
                "input:not([type=hidden]), textarea, select"
            )
            results = []

            for i in range(min(fields.count(), 60)):
                item = fields.nth(i)
                try:
                    typ = (item.get_attribute("type") or "text").lower()
                    if typ in ("password", "submit", "hidden", "file"):
                        continue

                    name = item.get_attribute("name") or ""
                    label = (
                        item.get_attribute("aria-label")
                        or item.get_attribute("placeholder")
                        or name
                    )
                    value = ""
                    if typ not in ("checkbox", "radio"):
                        value = item.input_value(timeout=1000)

                    results.append({
                        "name": name,
                        "type": typ,
                        "label": label,
                        "value": value
                    })
                except Exception:
                    continue

            browser.close()

        return jsonify(
            message=f"वेबसाइट खुल गई। {len(results)} फ़ील्ड मिले।",
            fields=results
        )
    except Exception:
        app.logger.exception("Browser inspection failed")
        return jsonify(error="वेबसाइट नहीं खुली या फ़ील्ड पढ़े नहीं जा सके।"), 502


@app.post("/fill")
def fill():
    data = request.get_json(silent=True) or {}
    url = str(data.get("url", "")).strip()
    values = data.get("values", [])

    valid, error = validate_url(url)
    if not valid:
        return jsonify(error=error), 400
    if not isinstance(values, list) or len(values) > 60:
        return jsonify(error="फ़ील्ड की सूची सही नहीं है।"), 400

    try:
        from playwright.sync_api import sync_playwright
        with sync_playwright() as p:
            browser = p.chromium.launch(headless=True)
            page = browser.new_page()
            page.goto(url, wait_until="domcontentloaded", timeout=20000)

            filled = 0
            failed = 0

            for item in values:
                try:
                    index = int(item.get("index", -1))
                    value = str(item.get("value", ""))

                    if index < 0 or len(value) > 2000:
                        failed += 1
                        continue

                    locator = page.locator(
                        "input:not([type=hidden]):not([type=password]):"
                        "not([type=submit]):not([type=file]), textarea, select"
                    ).nth(index)

                    typ = (locator.get_attribute("type") or "text").lower()
                    if typ in ("checkbox", "radio"):
                        failed += 1
                        continue

                    locator.fill(value, timeout=2000)
                    filled += 1
                except Exception:
                    failed += 1

            browser.close()

        return jsonify(
            message=f"{filled} फ़ील्ड भरने की कोशिश सफल रही; {failed} फ़ील्ड नहीं भरे जा सके।"
        )
    except Exception:
        app.logger.exception("Browser fill failed")
        return jsonify(error="फॉर्म के फ़ील्ड भरते समय समस्या आई।"), 502


