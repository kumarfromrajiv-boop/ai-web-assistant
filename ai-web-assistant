@app.post("/ask")
def ask():
    data = request.get_json(silent=True) or {}
    task = str(data.get("task", "")).strip()

    if not task:
        return jsonify(error="काम लिखें।"), 400

    if len(task) > 4000:
        return jsonify(error="काम का विवरण बहुत लंबा है।"), 400

    if client is None:
        return jsonify(error="AI API अभी कॉन्फ़िगर नहीं है।"), 503

    try:
        response = client.chat.completions.create(
            model=META_MODEL,
            messages=[
                {
                    "role": "system",
                    "content": "आप हिंदी में मदद करने वाले सहायक हैं।"
                },
                {"role": "user", "content": task}
            ]
        )
        answer = response.choices[0].message.content
        return jsonify(answer=answer or "जवाब नहीं मिला।")

    except Exception:
        app.logger.exception("AI request failed")
        return jsonify(error="AI सेवा से संपर्क नहीं हो पाया।"), 502

@app.post("/inspect")
def inspect():
    data = request.get_json(silent=True) or {}
    url = str(data.get("url", "")).strip()

    valid, error = validate_url(url)
    if not valid:
        return jsonify(error=error), 400

    try:
        from playwright.sync_api import sync_playwright

        with sync_playwright() as p:
            browser = p.chromium.launch(headless=True)
            try:
                page = browser.new_page()
                page.goto(
                    url,
                    wait_until="domcontentloaded",
                    timeout=20000
                )

                loc = page.locator(
                    "input:not([type=hidden]), textarea, select"
                )

                results = []

                for i in range(min(loc.count(), 60)):
                    el = loc.nth(i)

                    try:
                        typ = (el.get_attribute("type") or "text").lower()

                        if typ in (
                            "hidden", "password", "submit",
                            "file", "button", "reset"
                        ):
                            continue

                        name = el.get_attribute("name") or ""
                        label = (
                            el.get_attribute("aria-label")
                            or el.get_attribute("placeholder")
                            or name
                        )

                        results.append({
                            "name": name,
                            "type": typ,
                            "label": label
                        })

                    except Exception:
                        continue

            finally:
                browser.close()

        return jsonify(
            message=f"वेबसाइट खुल गई। {len(results)} फ़ील्ड मिले।",
            fields=results
        )

    except Exception:
        app.logger.exception("Inspection failed")
        return jsonify(error="वेबसाइट जाँची नहीं जा सकी।"), 502

@app.post("/fill")
def fill():
    data = request.get_json(silent=True) or {}
    url = str(data.get("url", "")).strip()
    values = data.get("values", [])

    valid, error = validate_url(url)
    if not valid:
        return jsonify(error=error), 400

    if not isinstance(values, list) or len(values) > 60:
        return jsonify(error="फ़ील्ड सूची गलत है।"), 400

    try:
        from playwright.sync_api import sync_playwright

        with sync_playwright() as p:
            browser = p.chromium.launch(headless=True)

            try:
                page = browser.new_page()
                page.goto(
                    url,
                    wait_until="domcontentloaded",
                    timeout=20000
                )

                loc = page.locator(
                    "input:not([type=hidden]):"
                    "not([type=password]):"
                    "not([type=submit]):"
                    "not([type=file]):"
                    "not([type=button]):"
                    "not([type=reset]), textarea, select"
                )

                count = min(loc.count(), 60)
                filled = 0
                failed = 0

                for item in values:
                    try:
                        index = int(item.get("index", -1))
                        value = str(item.get("value", ""))

                        if (
                            index < 0
                            or index >= count
                            or len(value) > 2000
                        ):
                            failed += 1
                            continue

                        el = loc.nth(index)
                        typ = (
                            el.get_attribute("type") or "text"
                        ).lower()

                        if typ in ("checkbox", "radio"):
                            failed += 1
                            continue

                        el.fill(value, timeout=2000)
                        filled += 1

                    except Exception:
                        failed += 1

            finally:
                browser.close()

        return jsonify(
            message=f"{filled} फ़ील्ड भरे; {failed} असफल।"
        )

    except Exception:
        app.logger.exception("Fill failed")
        return jsonify(error="फ़ील्ड भरने में समस्या आई।"), 502

